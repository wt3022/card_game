# ========================================
# カードゲームアプリケーション 環境変数設定
# ========================================
# ⚠️ 本番環境では必ずこのファイルをコピーして.envファイルを作成し、
#    すべてのシークレット値を安全な値に変更してください。
# ========================================

# ========================================
# MySQL設定
# ========================================
MYSQL_PORT=3306
# ⚠️ 本番環境では強力なランダムパスワードに変更してください
MYSQL_ROOT_PASSWORD=CHANGE_THIS_TO_STRONG_RANDOM_PASSWORD
MYSQL_DATABASE=card_game

# ========================================
# アプリケーション設定（Go側で使用）
# ========================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# ⚠️ MYSQL_ROOT_PASSWORDと同じ値にしてください
DB_PASSWORD=CHANGE_THIS_TO_STRONG_RANDOM_PASSWORD
DB_NAME=card_game

# ========================================
# サーバーポート
# ========================================
GAME_SERVER_PORT=8080
ADMIN_SERVER_PORT=8081

# ========================================
# JWT認証設定
# ========================================
# ⚠️ 必ず32文字以上のランダムな文字列に変更してください
# 生成方法: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_RANDOM_STRING_MIN_32_CHARS
# トークンの有効期限（時間）1-168時間（1時間〜7日）
JWT_EXPIRY_HOURS=24

# ========================================
# パスワードハッシュ設定
# ========================================
# bcryptのコスト（10-14推奨、デフォルト: 12）
# 高い値ほどセキュアだが処理時間が増加
BCRYPT_COST=12

# ========================================
# 初期管理者ユーザー設定
# ========================================
# ⚠️ 本番環境では必ず強力なパスワードに変更してください
# パスワード要件: 最低8文字、最大128文字
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD_MIN_8_CHARS

# ========================================
# セキュリティ設定（オプション）
# ========================================
# レート制限を無効化（開発用、本番環境では設定しない）
# DISABLE_RATE_LIMIT=false

# 不正検出を無効化（開発用、本番環境では設定しない）
# DISABLE_CHEAT_DETECTION=false

# 状態検証を無効化（開発用、本番環境では設定しない）
# DISABLE_STATE_VALIDATION=false
