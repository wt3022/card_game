# MySQL設定
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=card_game
MYSQL_USER=card_user
MYSQL_PASSWORD=card_pass

# アプリケーション設定（Go側で使用）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=card_game

# サーバーポート
GAME_SERVER_PORT=8080
ADMIN_SERVER_PORT=8081

# JWT認証設定
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRY_HOURS=24

# 初期管理者ユーザー設定（初回起動時に自動作成）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
